{
  "name": "gm-zapchast",
  "productName": "GM Zapchast",
  "version": "1.3.0",
  "description": "Avtoehtiyot qismlar do'koni uchun sotuv va ombor dasturi",
  "author": "GM Zapchast",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^31.7.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "uz.gmzapchast.app",
    "productName": "GM Zapchast",
    "copyright": "GM Zapchast",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "app/**/*", "build/icon.png"],
    "asar": true,
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GM Zapchast",
      "artifactName": "GM-Zapchast-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "GM-Zapchast-portable-${version}.exe"
    }
  }
}
